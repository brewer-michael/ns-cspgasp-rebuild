# Open Speaker: lines for the Raspberry Pi boot configuration
#
# scripts/install.sh adds these to /boot/firmware/config.txt (/boot/config.txt on
# older systems) between "# >>> open-speaker" and "# <<< open-speaker" markers.
# To do it by hand, add them at the end and reboot.

[all]

# The onboard audio would claim the first sound card. Also comment out any
# existing "dtparam=audio=on" line.
dtparam=audio=off

# One I2S sound card for both directions: playback to the two MAX98357A
# amplifiers and capture from the two INMP441 microphones, at the same time.
# (hifiberry-dac, from the earlier plan, is playback only.)
# The overlay claims GPIO16 for a shutdown line: leave GPIO16 unconnected.
dtoverlay=googlevoicehat-soundcard

# OLED display on I2C (GPIO2 SDA, GPIO3 SCL); 400 kHz makes updates snappier
dtparam=i2c_arm=on
dtparam=i2c_arm_baudrate=400000

# WS2812B status LEDs are driven from SPI MOSI (GPIO10), which needs no root
# access. The SPI clock comes from the core clock, so keep that fixed or the
# LED colours glitch when the CPU speed changes.
dtparam=spi=on
core_freq=250

# Pins in use (BCM numbering), see hardware/schematics/gpio_pinout.md:
#   18 I2S BCLK   19 I2S LRCLK   20 I2S DIN (mics)   21 I2S DOUT (amps)
#   2/3 I2C (OLED)   10 SPI MOSI (LEDs)   12 volume LED
#   17 volume up   27 volume down   22 mute   5 action
#   (23/24 TM1637 if you use that display instead of the OLED)
