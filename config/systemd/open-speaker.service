[Unit]
Description=Open Hardware Smart Speaker
After=network.target sound.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/open-speaker/firmware
ExecStart=/usr/bin/python3 /home/pi/open-speaker/firmware/main.py
Restart=always
RestartSec=5

# Environment
Environment=PYTHONUNBUFFERED=1

# Resource limits
MemoryMax=128M
CPUQuota=50%

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
