[Unit]
Description=Open Speaker voice assistant and clock
Documentation=https://github.com/brewer-michael/ns-cspgasp-rebuild
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=open-speaker
Group=open-speaker
SupplementaryGroups=audio gpio spi i2c
EnvironmentFile=-/etc/open-speaker/secrets.env
ExecStart=/opt/open-speaker/venv/bin/open-speaker --config /etc/open-speaker/config.yaml run
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Timers and alarms are kept here
StateDirectory=open-speaker
StateDirectoryMode=0750
WorkingDirectory=/var/lib/open-speaker
# lgpio (behind gpiozero) creates a notification pipe in LG_WD, or else in the
# working directory
RuntimeDirectory=open-speaker
Environment=LG_WD=/run/open-speaker

# Audio should not stutter when something else is busy
Nice=-5
MemoryMax=256M

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
